{{!
    @template theme_diverse/course_hero

    Header of every tab of a course: the way back in the title row of the page, then a card with the category, name,
    summary, teachers and figures, and next to them the cover, the next step and the progress.

    Example context (json):
    {
        "mycoursesurl": "#", "name": "Business Law", "category": "Istanbul Beykent University", "teachers": "Ada Yilmaz",
        "summary": "Contracts, liability and companies.", "stats": "5 sections, 7 activities", "people": 12,
        "coverstyle": "brand", "initials": "BL", "hasprogress": true, "progress": 40, "hasstep": true,
        "hasnext": true, "nexturl": "#", "nextname": "What is Business Law?", "nexttype": "Page", "nextlabel": "Continue"
    }
}}
<nav class="diverse-title-bar diverse-course-crumbs" aria-label="{{#str}}breadcrumb, access{{/str}}">
    <ol>
        <li><a href="{{mycoursesurl}}"><i class="fa fa-chevron-left" aria-hidden="true"></i>{{#str}}mycourses{{/str}}</a></li>
        <li aria-current="page">{{name}}</li>
    </ol>
</nav>
<section class="diverse-hero-course" aria-label="{{name}}">
    <div class="diverse-hero-course-text">
        {{#category}}<span class="diverse-tag">{{category}}</span>{{/category}}
        <h1 class="diverse-hero-course-title">{{name}}</h1>
        {{#summary}}<p class="diverse-hero-course-summary">{{summary}}</p>{{/summary}}
        <p class="diverse-hero-course-meta">
            {{#teachers}}<span><i class="fa fa-user" aria-hidden="true"></i>{{teachers}}</span>{{/teachers}}
            <span><i class="fa fa-book" aria-hidden="true"></i>{{stats}}</span>
            <span><i class="fa fa-users" aria-hidden="true"></i>{{#str}}card_people, theme_diverse, {{people}}{{/str}}</span>
            {{#language}}<span><i class="fa fa-globe" aria-hidden="true"></i>{{language}}</span>{{/language}}
        </p>
    </div>
    <div class="diverse-hero-course-card{{^hasstep}} diverse-hero-course-cardonly{{/hasstep}}">
        <div class="diverse-hero-course-next">
            {{> theme_diverse/course_cover }}
            {{#hasnext}}
            <span>
                <small>{{#str}}course_upnext, theme_diverse{{/str}}</small>
                <strong>{{nextname}}</strong>
                <small>{{nexttype}}</small>
            </span>
            {{/hasnext}}
        </div>
        {{#hasprogress}}
        <div class="diverse-progress">
            <div class="diverse-progress-track"><span style="width: {{progress}}%;"></span></div>
            <span class="diverse-progress-value">{{#str}}dash_progress, theme_diverse, {{progress}}{{/str}}</span>
        </div>
        {{/hasprogress}}
        {{#hasnext}}
        <a class="btn btn-primary" href="{{nexturl}}">{{nextlabel}} <i class="fa fa-chevron-right" aria-hidden="true"></i></a>
        {{/hasnext}}
    </div>
</section>
