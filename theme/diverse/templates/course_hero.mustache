{{!
    @template theme_diverse/course_hero

    Header of every tab of a course: the way back, name, teachers, cover, progress and the next step.

    Example context (json):
    {
        "navbar": "", "name": "Business Law", "category": "Istanbul Beykent University", "teachers": "Ada Yilmaz",
        "summary": "Contracts, liability and companies.", "stats": "5 sections, 7 activities", "people": 12,
        "coverstyle": "brand", "isplus": true, "hasprogress": true, "progress": 40,
        "hasnext": true, "nexturl": "#", "nextname": "What is Business Law?", "nextlabel": "Continue"
    }
}}
<section class="diverse-hero-course" aria-label="{{name}}">
    <div class="diverse-hero-course-text">
        {{{navbar}}}
        {{#category}}<p class="diverse-hero-course-category">{{category}}</p>{{/category}}
        <h1 class="diverse-hero-course-title">{{name}}</h1>
        {{#summary}}<p class="diverse-hero-course-summary">{{summary}}</p>{{/summary}}
        <p class="diverse-hero-course-meta">
            {{#teachers}}<span>{{teachers}}</span>{{/teachers}}
            <span>{{stats}}</span>
            <span>{{#str}}card_people, theme_diverse, {{people}}{{/str}}</span>
        </p>
    </div>
    <div class="diverse-hero-course-card{{^hasstep}} diverse-hero-course-cardonly{{/hasstep}}">
        {{> theme_diverse/course_cover }}
        {{#hasprogress}}
        <div class="diverse-progress">
            <div class="diverse-progress-track"><span style="width: {{progress}}%;"></span></div>
            <span class="diverse-progress-value">{{#str}}dash_progress, theme_diverse, {{progress}}{{/str}}</span>
        </div>
        {{/hasprogress}}
        {{#hasnext}}
        <a class="btn btn-primary" href="{{nexturl}}">{{nextlabel}}</a>
        <span class="diverse-hero-course-nextname">{{nextname}}</span>
        {{/hasnext}}
    </div>
</section>
