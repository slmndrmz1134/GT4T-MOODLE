{{!
    @template theme_diverse/dashboard

    Dashboard built from the user's roles: administrator, teacher and student sections.

    Example context (json):
    {
        "greeting": "Hello, Ada", "today": "Monday, 2 November", "summary": "You are up to date.",
        "allcoursesurl": "#", "calendarurl": "#", "hastodo": false, "nocontent": true
    }
}}
<div class="diverse-dash">
    <header class="diverse-dash-head diverse-dash-hero">
        <div class="diverse-dash-avatar">{{{avatar}}}</div>
        <div class="diverse-dash-welcome">
            <p class="diverse-dash-date">{{today}}</p>
            <h1 class="diverse-dash-title">{{greeting}}</h1>
            <p class="diverse-dash-summary">{{summary}}</p>
            {{#hero}}
            <p class="diverse-dash-hero-action">
                <a class="btn btn-primary" href="{{url}}">{{label}}</a>
                <span>{{next}}</span>
            </p>
            {{/hero}}
        </div>
        {{#isadmin}}<a class="btn btn-primary" href="{{admin.actions.0.url}}">{{admin.actions.0.label}}</a>{{/isadmin}}
    </header>

    {{#learning}}
    <ul class="diverse-kpi-row" aria-label="{{#str}}dash_resume, theme_diverse{{/str}}">
        {{#kpis}}
        <li class="diverse-kpi">
            {{#ring}}<span class="diverse-ring" style="--diverse-ring: {{progress}};" aria-hidden="true"></span>{{/ring}}
            {{^ring}}<span class="diverse-kpi-icon" aria-hidden="true"><i class="fa {{icon}}"></i></span>{{/ring}}
            <span class="diverse-kpi-text"><strong>{{value}}</strong><span>{{label}}</span></span>
        </li>
        {{/kpis}}
    </ul>
    {{/learning}}

    {{#hascategories}}
    <nav class="diverse-category-strip" aria-label="{{#str}}nav_discover, theme_diverse{{/str}}">
        <a href="{{catalogurl}}">{{#str}}dash_allcategories, theme_diverse{{/str}}</a>
        {{#categories}}<a href="{{url}}">{{name}} <span>{{count}}</span></a>{{/categories}}
    </nav>
    {{/hascategories}}

    {{#admin}}
    <section class="diverse-dash-section" aria-labelledby="diverse-dash-site">
        <h2 class="diverse-dash-heading" id="diverse-dash-site">{{#str}}dash_site, theme_diverse{{/str}}</h2>
        <ul class="diverse-stat-row">
            {{#stats}}
            <li class="diverse-stat-tile{{#attention}} attention{{/attention}}"><strong>{{value}}</strong><span>{{label}}</span></li>
            {{/stats}}
        </ul>
        <div class="diverse-dash-grid">
            <div class="diverse-panel">
                <h3 class="diverse-panel-title">{{#str}}dash_partners, theme_diverse{{/str}}</h3>
                {{#haspartners}}
                <table class="diverse-table">
                    <thead><tr>
                        <th scope="col">{{#str}}dash_partner, theme_diverse{{/str}}</th>
                        <th scope="col" class="num">{{#str}}users{{/str}}</th>
                        <th scope="col" class="num">{{#str}}courses{{/str}}</th>
                    </tr></thead>
                    <tbody>
                        {{#partners}}
                        <tr><th scope="row"><a href="{{url}}">{{name}}</a></th><td class="num">{{users}}</td><td class="num">{{courses}}</td></tr>
                        {{/partners}}
                    </tbody>
                </table>
                {{/haspartners}}
                {{^haspartners}}<p class="diverse-empty">{{#str}}partnerlogin_none, theme_diverse{{/str}}</p>{{/haspartners}}
            </div>
            <div class="diverse-dash-side">
                <div class="diverse-panel">
                    <h3 class="diverse-panel-title">{{#str}}dash_actions, theme_diverse{{/str}}</h3>
                    <ul class="diverse-link-list">
                        {{#actions}}<li><a href="{{url}}">{{label}}</a></li>{{/actions}}
                    </ul>
                </div>
                <div class="diverse-panel">
                    <h3 class="diverse-panel-title">{{#str}}dash_system, theme_diverse{{/str}}</h3>
                    <p class="diverse-status{{^cronok}} attention{{/cronok}}">{{cron}}</p>
                    <p class="diverse-small-muted">Moodle {{version}}</p>
                    {{#pending}}<p><a href="{{pendingurl}}">{{#str}}dash_pending_review, theme_diverse{{/str}}</a></p>{{/pending}}
                </div>
            </div>
        </div>
    </section>
    {{/admin}}

    {{#learning}}
    <section class="diverse-dash-section" aria-labelledby="diverse-dash-resume">
        <div class="diverse-dash-row">
            <h2 class="diverse-dash-heading" id="diverse-dash-resume">{{#str}}dash_resume, theme_diverse{{/str}}</h2>
            <a class="diverse-more-link" href="{{allcoursesurl}}">{{#str}}mycourses{{/str}}</a>
        </div>
        <ul class="diverse-resume-grid">
            {{#resume}}
            <li><a class="diverse-resume" href="{{url}}">
                <span class="diverse-resume-cover">
                    {{> theme_diverse/course_cover }}
                    <span class="diverse-cover-count">{{#str}}card_activities, theme_diverse, {{activities}}{{/str}}</span>
                </span>
                <span class="diverse-resume-body">
                    <span class="diverse-resume-course">{{name}}</span>
                    <span class="diverse-resume-next">{{#next}}{{next}}{{/next}}{{^next}}{{name}}{{/next}}</span>
                    <span class="diverse-resume-meta">{{type}}{{#lastaccess}}{{#type}} · {{/type}}{{lastaccess}}{{/lastaccess}}</span>
                    <span class="diverse-card-course-footer">
                        {{#hasprogress}}
                        <span class="diverse-progress">
                            <span class="diverse-progress-track"><span style="width: {{progress}}%;"></span></span>
                            <span class="diverse-progress-value">{{#str}}dash_progress, theme_diverse, {{progress}}{{/str}}</span>
                        </span>
                        {{/hasprogress}}
                        <span class="btn btn-sm btn-primary">{{action}}</span>
                    </span>
                </span>
            </a></li>
            {{/resume}}
        </ul>
    </section>
    {{/learning}}

    {{#teaching}}
    <section class="diverse-dash-section" aria-labelledby="diverse-dash-teaching">
        <h2 class="diverse-dash-heading" id="diverse-dash-teaching">{{#str}}dash_teaching, theme_diverse{{/str}}</h2>
        <ul class="diverse-stat-row">
            {{#stats}}
            <li class="diverse-stat-tile{{#attention}} attention{{/attention}}"><strong>{{value}}</strong><span>{{label}}</span></li>
            {{/stats}}
        </ul>
        {{#hasgrading}}
        <div class="diverse-panel">
            <h3 class="diverse-panel-title">{{#str}}dash_needsgrading, theme_diverse{{/str}}</h3>
            <ul class="diverse-work-list">
                {{#grading}}
                <li><a href="{{url}}"><span class="diverse-work-name">{{name}}</span><span class="diverse-work-meta">{{course}}</span></a><span class="diverse-count">{{count}}</span></li>
                {{/grading}}
            </ul>
        </div>
        {{/hasgrading}}
        <ul class="diverse-course-grid">
            {{#courses}}
            <li class="diverse-tile-course">
                <a class="diverse-tile-course-cover" href="{{url}}" tabindex="-1" aria-hidden="true">{{> theme_diverse/course_cover }}</a>
                <div class="diverse-tile-course-body">
                    <span class="diverse-tile-course-category">{{category}}</span>
                    <a class="diverse-tile-course-name" href="{{url}}">{{name}}</a>
                    <p class="diverse-tile-course-meta">{{#str}}dash_course_students, theme_diverse, {{students}}{{/str}}</p>
                    <p class="diverse-tile-course-links">
                        <a href="{{participantsurl}}">{{#str}}participants{{/str}}</a>
                        <a href="{{gradebookurl}}">{{#str}}grades{{/str}}{{#waiting}} <span class="diverse-count">{{waiting}}</span>{{/waiting}}</a>
                    </p>
                </div>
            </li>
            {{/courses}}
        </ul>
        {{#more}}<p class="diverse-more"><a href="{{allcoursesurl}}">{{#str}}dash_allcourses, theme_diverse{{/str}}</a></p>{{/more}}
    </section>
    {{/teaching}}

    {{#showtodo}}
    <div class="diverse-dash-grid{{^learning}} diverse-dash-grid-single{{/learning}}">
        <section class="diverse-dash-section" aria-labelledby="diverse-dash-todo">
            <h2 class="diverse-dash-heading" id="diverse-dash-todo">{{#str}}dash_todo, theme_diverse{{/str}}</h2>
            <div class="diverse-panel">
                <ol class="diverse-week">
                    {{#week}}
                    <li class="{{#today}}today{{/today}}{{#busy}} busy{{/busy}}"><a href="{{url}}" aria-label="{{date}}"{{#today}} aria-current="date"{{/today}}><span>{{weekday}}</span><strong>{{day}}</strong></a></li>
                    {{/week}}
                </ol>
                {{#todo}}
                <h3 class="diverse-todo-group{{#overdue}} overdue{{/overdue}}">{{title}}</h3>
                <ul class="diverse-work-list">
                    {{#items}}
                    <li>
                        <a href="{{url}}"><span class="diverse-work-name">{{name}}</span><span class="diverse-work-meta">{{course}} · {{time}}</span></a>
                        <a class="btn btn-sm btn-outline-secondary" href="{{url}}" tabindex="-1" aria-hidden="true">{{action}}</a>
                    </li>
                    {{/items}}
                </ul>
                {{/todo}}
                {{^hastodo}}<p class="diverse-empty">{{#str}}dash_todo_empty, theme_diverse{{/str}}</p>{{/hastodo}}
                {{#todomore}}<p class="diverse-more"><a href="{{calendarurl}}">{{#str}}dash_allwork, theme_diverse, {{todototal}}{{/str}}</a></p>{{/todomore}}
            </div>
        </section>
        {{#learning}}
        <div class="diverse-dash-side">
        <section class="diverse-dash-section" aria-labelledby="diverse-dash-grades">
            <h2 class="diverse-dash-heading" id="diverse-dash-grades">{{#str}}dash_recentgrades, theme_diverse{{/str}}</h2>
            <div class="diverse-panel">
                {{#hasgrades}}
                <ul class="diverse-work-list">
                    {{#grades}}
                    <li>
                        <div><span class="diverse-work-name">{{name}}</span><span class="diverse-work-meta">{{course}}</span>
                        {{#hasfeedback}}<span class="diverse-work-feedback">{{feedback}}</span>{{/hasfeedback}}</div>
                        <span class="diverse-grade">{{grade}}</span>
                    </li>
                    {{/grades}}
                </ul>
                <p class="diverse-more"><a href="{{gradesurl}}">{{#str}}dash_allgrades, theme_diverse{{/str}}</a></p>
                {{/hasgrades}}
                {{^hasgrades}}<p class="diverse-empty">{{#str}}dash_nogrades, theme_diverse{{/str}}</p>{{/hasgrades}}
            </div>
        </section>
        {{#hasactivity}}
        <section class="diverse-dash-section" aria-labelledby="diverse-dash-activity">
            <h2 class="diverse-dash-heading" id="diverse-dash-activity">{{#str}}dash_activity, theme_diverse{{/str}}</h2>
            <div class="diverse-panel">
                {{#activity}}
                <ol class="diverse-bars">
                    {{#bars}}
                    <li class="{{#today}}today{{/today}}" title="{{description}}">
                        <span class="diverse-bar"><span style="height: {{height}}%;"></span></span>
                        <span class="diverse-bar-label">{{label}}</span>
                        <span class="visually-hidden">{{description}}</span>
                    </li>
                    {{/bars}}
                </ol>
                {{#empty}}<p class="diverse-empty">{{#str}}dash_activity_none, theme_diverse{{/str}}</p>{{/empty}}
                {{/activity}}
            </div>
        </section>
        {{/hasactivity}}
        </div>
        {{/learning}}
    </div>
    {{/showtodo}}

    {{#learning}}
    {{#hascourses}}
    <section class="diverse-dash-section" aria-labelledby="diverse-dash-courses">
        <div class="diverse-dash-row">
            <h2 class="diverse-dash-heading" id="diverse-dash-courses">{{#str}}mycourses{{/str}}</h2>
            {{#more}}<a class="diverse-more-link" href="{{allcoursesurl}}">{{#str}}dash_allcourses, theme_diverse{{/str}}</a>{{/more}}
        </div>
        <ul class="diverse-card-grid">
            {{#courses}}{{> theme_diverse/course_card }}{{/courses}}
        </ul>
    </section>
    {{/hascourses}}
    {{/learning}}

    {{#hasrecommended}}
    <section class="diverse-dash-section" aria-labelledby="diverse-dash-recommended">
        <div class="diverse-dash-row">
            <h2 class="diverse-dash-heading" id="diverse-dash-recommended">{{#str}}dash_recommended, theme_diverse{{/str}}</h2>
            <a class="diverse-more-link" href="{{catalogurl}}">{{#str}}nav_discover, theme_diverse{{/str}}</a>
        </div>
        <ul class="diverse-card-grid">
            {{#recommended}}{{> theme_diverse/course_card }}{{/recommended}}
        </ul>
    </section>
    {{/hasrecommended}}

    {{#nocontent}}
    <div class="diverse-panel"><p class="diverse-empty">{{#str}}dash_nocourses, theme_diverse{{/str}}</p></div>
    {{/nocontent}}
</div>
