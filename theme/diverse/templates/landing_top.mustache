{{!
    @template theme_diverse/landing_top

    Landing page sections shown above the site home content.

    Context variables required for this template:
    * loggedin - whether the viewer is logged in (not a guest)
    * loginurl, dashboardurl - where the main button leads visitors and logged-in users
    * hasheroimage, heroimage - the photo behind the hero (pix/hero.jpg); without it the hero is the plain brand colour
    * haslogos, logos - partners with a logo, for the strip under the hero
    * partners, partnercount, countrycount - GT4T project partners (name, country, url, domain, lead, logourl, photourl)
    * coursecount - live number of visible courses
    * hascourses, courses, allcoursesurl - featured courses

    Example context (json):
    {
        "loggedin": false, "loginurl": "#", "dashboardurl": "#", "allcoursesurl": "#",
        "hasheroimage": false, "heroimage": null, "haslogos": false, "logos": [],
        "partnercount": 1, "countrycount": 1,
        "partners": [{"name": "Griffith College", "country": "Ireland", "url": "#", "domain": "griffith.ie", "lead": false,
            "logourl": null, "photourl": null}],
        "coursecount": 17,
        "hascourses": true,
        "courses": [{"fullname": "Business Law", "shortname": "LAW202", "category": "Istanbul Beykent University",
            "url": "#", "hasimage": false, "coverstyle": "brand", "initials": "BL"}]
    }
}}
<div class="diverse-landing">
    <section class="diverse-hero{{#hasheroimage}} diverse-hero-image{{/hasheroimage}}">
        {{#hasheroimage}}<img class="diverse-hero-bg" src="{{heroimage}}" alt="">{{/hasheroimage}}
        <div class="diverse-hero-inner">
            <div class="diverse-hero-text">
                <p class="diverse-eyebrow">{{#str}}landing_eyebrow, theme_diverse{{/str}}</p>
                <h1 class="diverse-hero-title">{{#str}}landing_title, theme_diverse{{/str}}</h1>
                <p class="diverse-hero-tagline">{{#str}}landing_tagline, theme_diverse{{/str}}</p>
                <p class="diverse-hero-intro">{{#str}}landing_intro, theme_diverse{{/str}}</p>
                <div class="diverse-hero-actions">
                    <a class="btn btn-lg {{#hasheroimage}}btn-primary{{/hasheroimage}}{{^hasheroimage}}diverse-btn-ink{{/hasheroimage}}"
                        href="{{#loggedin}}{{dashboardurl}}{{/loggedin}}{{^loggedin}}{{loginurl}}{{/loggedin}}">
                        {{#loggedin}}{{#str}}myhome{{/str}}{{/loggedin}}
                        {{^loggedin}}{{#str}}landing_getstarted, theme_diverse{{/str}}{{/loggedin}}
                    </a>
                    <a class="btn btn-lg {{#hasheroimage}}diverse-btn-outline-light{{/hasheroimage}}{{^hasheroimage}}diverse-btn-outline-ink{{/hasheroimage}}"
                        href="#diverse-partners">{{#str}}landing_meetpartners, theme_diverse{{/str}}</a>
                </div>
            </div>
            <dl class="diverse-hero-stats">
                <div><dt>{{#str}}stat_projectpartners, theme_diverse{{/str}}</dt><dd>{{partnercount}}</dd></div>
                <div><dt>{{#str}}stat_countries, theme_diverse{{/str}}</dt><dd>{{countrycount}}</dd></div>
                <div><dt>{{#str}}stat_courses, theme_diverse{{/str}}</dt><dd>{{coursecount}}</dd></div>
            </dl>
        </div>
    </section>

    {{#haslogos}}
    <section class="diverse-logos" aria-label="{{#str}}partners_eyebrow, theme_diverse{{/str}}">
        <ul>
            {{#logos}}<li><a href="{{url}}" target="_blank" rel="noopener"><img src="{{logourl}}" alt="{{name}}"></a></li>{{/logos}}
        </ul>
    </section>
    {{/haslogos}}

    <section class="diverse-section diverse-about" id="diverse-about" aria-labelledby="diverse-about-title">
        <div class="diverse-split">
            <div class="diverse-section-head">
                <p class="diverse-eyebrow">{{#str}}about_eyebrow, theme_diverse{{/str}}</p>
                <h2 class="diverse-section-title" id="diverse-about-title">{{#str}}about_title, theme_diverse{{/str}}</h2>
                <p class="diverse-lead">{{#str}}about_intro, theme_diverse{{/str}}</p>
                <p class="diverse-muted">{{#str}}about_support, theme_diverse{{/str}}</p>
            </div>
            <ul class="diverse-feature-list">
                <li>
                    <span class="diverse-feature-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 0 1-15.5 6.2M3 12a9 9 0 0 1 15.5-6.2"></path><path d="M18.5 2v4h-4M5.5 22v-4h4"></path></svg></span>
                    <div><h3>{{#str}}focus_item1_title, theme_diverse{{/str}}</h3><p>{{#str}}focus_item1_desc, theme_diverse{{/str}}</p></div>
                </li>
                <li>
                    <span class="diverse-feature-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="12" rx="2"></rect><path d="M8 20h8M12 16v4"></path></svg></span>
                    <div><h3>{{#str}}focus_item2_title, theme_diverse{{/str}}</h3><p>{{#str}}focus_item2_desc, theme_diverse{{/str}}</p></div>
                </li>
                <li>
                    <span class="diverse-feature-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L4 14h7l-1 8 9-12h-7z"></path></svg></span>
                    <div><h3>{{#str}}focus_item3_title, theme_diverse{{/str}}</h3><p>{{#str}}focus_item3_desc, theme_diverse{{/str}}</p></div>
                </li>
            </ul>
        </div>
    </section>

    <section class="diverse-section diverse-steps" aria-labelledby="diverse-steps-title">
        <div class="diverse-section-head">
            <p class="diverse-eyebrow">{{#str}}steps_eyebrow, theme_diverse{{/str}}</p>
            <h2 class="diverse-section-title" id="diverse-steps-title">{{#str}}steps_title, theme_diverse{{/str}}</h2>
        </div>
        <ol class="diverse-step-list">
            <li><span class="diverse-step-number" aria-hidden="true">01</span>
                <h3>{{#str}}step1_title, theme_diverse{{/str}}</h3><p>{{#str}}step1_desc, theme_diverse{{/str}}</p></li>
            <li><span class="diverse-step-number" aria-hidden="true">02</span>
                <h3>{{#str}}step2_title, theme_diverse{{/str}}</h3><p>{{#str}}step2_desc, theme_diverse{{/str}}</p></li>
            <li><span class="diverse-step-number" aria-hidden="true">03</span>
                <h3>{{#str}}step3_title, theme_diverse{{/str}}</h3><p>{{#str}}step3_desc, theme_diverse{{/str}}</p></li>
        </ol>
    </section>

    {{#hascourses}}
    <section class="diverse-section diverse-courses" id="diverse-courses" aria-labelledby="diverse-courses-title">
        <div class="diverse-section-head diverse-section-head-row">
            <h2 class="diverse-section-title" id="diverse-courses-title">{{#str}}courses_title, theme_diverse{{/str}}</h2>
            <a class="diverse-link-strong" href="{{allcoursesurl}}">{{#str}}courses_all, theme_diverse, {{coursecount}}{{/str}} <span aria-hidden="true">&rarr;</span></a>
        </div>
        <div class="diverse-cards diverse-cards-4">
            {{#courses}}
            <a class="diverse-course" href="{{url}}">
                <span class="diverse-course-top">
                    {{> theme_diverse/course_cover }}
                    <span class="diverse-chip">{{shortname}}</span>
                </span>
                <div class="diverse-course-body">
                    <span class="diverse-muted diverse-small">{{category}}</span>
                    <span class="diverse-course-title">{{fullname}}</span>
                </div>
            </a>
            {{/courses}}
        </div>
    </section>
    {{/hascourses}}

    <section class="diverse-section diverse-partners" id="diverse-partners" aria-labelledby="diverse-partners-title">
        <div class="diverse-section-head">
            <p class="diverse-eyebrow">{{#str}}partners_eyebrow, theme_diverse{{/str}}</p>
            <h2 class="diverse-section-title" id="diverse-partners-title">{{#str}}partners_title, theme_diverse{{/str}}</h2>
            <p class="diverse-lead">{{#str}}partners_intro, theme_diverse{{/str}}</p>
        </div>
        <ul class="diverse-cards diverse-cards-4 diverse-partner-list">
            {{#partners}}
            <li class="diverse-partner">
                <span class="diverse-partner-photo" aria-hidden="true">
                    {{#photourl}}<img src="{{photourl}}" alt="">{{/photourl}}
                    {{^photourl}}{{#logourl}}<img class="diverse-partner-photo-logo" src="{{logourl}}" alt="">{{/logourl}}{{/photourl}}
                    {{^photourl}}{{^logourl}}<span class="diverse-course-initials">{{initials}}</span>{{/logourl}}{{/photourl}}
                    {{#lead}}<span class="diverse-partner-badge">{{#str}}partners_lead, theme_diverse{{/str}}</span>{{/lead}}
                </span>
                <div class="diverse-partner-body">
                    <h3 class="diverse-partner-name">{{name}}</h3>
                    <span class="diverse-muted">{{country}}</span>
                    <a href="{{url}}" target="_blank" rel="noopener"><span class="visually-hidden">{{name}}: </span>{{domain}} <span aria-hidden="true">&nearr;</span></a>
                </div>
            </li>
            {{/partners}}
        </ul>
    </section>
</div>
{{#js}}
document.querySelectorAll('.primary-navigation a[href*="#diverse-"]').forEach(function(anchor) {
    anchor.addEventListener('click', function(e) {
        var href = this.getAttribute('href');
        var hashIndex = href.indexOf('#');
        if (hashIndex !== -1) {
            var hash = href.substring(hashIndex + 1);
            var target = document.getElementById(hash);
            if (target) {
                e.preventDefault();
                target.scrollIntoView({ behavior: 'smooth' });
                if (history.pushState) {
                    history.pushState(null, null, '#' + hash);
                }
            }
        }
    });
});
{{/js}}
