{{!
    @template theme_diverse/landing_top

    Landing page sections shown above the site home content.

    Context variables required for this template:
    * loggedin - whether the viewer is logged in (not a guest)
    * loginurl, dashboardurl - where the main button leads visitors and logged-in users
    * partners, partnercount, countrycount - GT4T project partners (name, country, url, domain, lead)
    * coursecount - live number of visible courses
    * hascourses, courses, allcoursesurl - featured courses

    Example context (json):
    {
        "loggedin": false, "loginurl": "#", "dashboardurl": "#", "allcoursesurl": "#",
        "partnercount": 1, "countrycount": 1,
        "partners": [{"name": "Griffith College", "country": "Ireland", "url": "#", "domain": "griffith.ie", "lead": false}],
        "coursecount": 17,
        "hascourses": true,
        "courses": [{"fullname": "Business Law", "shortname": "LAW202", "category": "Istanbul Beykent University",
            "url": "#", "hasimage": false, "coverstyle": "brand", "isplus": true}]
    }
}}
<div class="diverse-landing">
    <section class="diverse-hero">
        <div class="diverse-hero-inner">
            <div class="diverse-hero-text">
                <p class="diverse-eyebrow diverse-eyebrow-dark">{{#str}}landing_eyebrow, theme_diverse{{/str}}</p>
                <h1 class="diverse-hero-title">{{#str}}landing_title, theme_diverse{{/str}}</h1>
                <p class="diverse-hero-tagline">{{#str}}landing_tagline, theme_diverse{{/str}}</p>
                <p class="diverse-hero-intro">{{#str}}landing_intro, theme_diverse{{/str}}</p>
                <div class="diverse-hero-actions">
                    <a class="btn btn-lg diverse-btn-ink" href="{{#loggedin}}{{dashboardurl}}{{/loggedin}}{{^loggedin}}{{loginurl}}{{/loggedin}}">
                        {{#loggedin}}{{#str}}myhome{{/str}}{{/loggedin}}
                        {{^loggedin}}{{#str}}landing_getstarted, theme_diverse{{/str}}{{/loggedin}}
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
                    </a>
                    <a class="btn btn-lg diverse-btn-outline-ink" href="#diverse-partners">{{#str}}landing_meetpartners, theme_diverse{{/str}}</a>
                </div>
            </div>
            <div class="diverse-pattern" aria-hidden="true">
                <div class="diverse-tile diverse-tile-ink-brand"><svg viewBox="0 0 100 100"><path d="M50 20v60M20 50h60" stroke="currentColor" stroke-width="14" stroke-linecap="round" fill="none"></path></svg></div>
                <div class="diverse-tile diverse-tile-soft-brand"><svg viewBox="0 0 100 100"><circle cx="50" cy="50" r="28" fill="none" stroke="currentColor" stroke-width="12"></circle></svg></div>
                <div class="diverse-tile diverse-tile-brand-ink"><svg viewBox="0 0 100 100" fill="currentColor"><circle cx="25" cy="25" r="7"></circle><circle cx="50" cy="25" r="7"></circle><circle cx="75" cy="25" r="7"></circle><circle cx="25" cy="50" r="7"></circle><circle cx="50" cy="50" r="7"></circle><circle cx="75" cy="50" r="7"></circle><circle cx="25" cy="75" r="7"></circle><circle cx="50" cy="75" r="7"></circle><circle cx="75" cy="75" r="7"></circle></svg></div>
                <div class="diverse-tile diverse-tile-white-brand"><svg viewBox="0 0 100 100"><path d="M40 18L34 82M68 18L62 82M20 38h64M16 62h64" stroke="currentColor" stroke-width="10" stroke-linecap="round" fill="none"></path></svg></div>
                <div class="diverse-tile diverse-tile-peach-ink"><svg viewBox="0 0 100 100"><path d="M10 72a40 40 0 0 1 80 0z" fill="currentColor"></path></svg></div>
                <div class="diverse-tile diverse-tile-ink-white"><svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="7"><circle cx="50" cy="50" r="38"></circle><circle cx="50" cy="50" r="24"></circle><circle cx="50" cy="50" r="10"></circle></svg></div>
                <div class="diverse-tile diverse-tile-soft-brand"><svg viewBox="0 0 100 100"><path d="M20 50h56M56 28l22 22-22 22" stroke="currentColor" stroke-width="12" stroke-linecap="round" stroke-linejoin="round" fill="none"></path></svg></div>
                <div class="diverse-tile diverse-tile-brand-white"><svg viewBox="0 0 100 100"><path d="M50 20v60M20 50h60" stroke="currentColor" stroke-width="14" stroke-linecap="round" fill="none"></path></svg></div>
                <div class="diverse-tile diverse-tile-white-brand"><svg viewBox="0 0 100 100" fill="currentColor"><circle cx="25" cy="25" r="7"></circle><circle cx="50" cy="25" r="7"></circle><circle cx="75" cy="25" r="7"></circle><circle cx="25" cy="50" r="7"></circle><circle cx="50" cy="50" r="7"></circle><circle cx="75" cy="50" r="7"></circle><circle cx="25" cy="75" r="7"></circle><circle cx="50" cy="75" r="7"></circle><circle cx="75" cy="75" r="7"></circle></svg></div>
                <div class="diverse-tile diverse-tile-brand-ink"><svg viewBox="0 0 100 100"><path d="M40 18L34 82M68 18L62 82M20 38h64M16 62h64" stroke="currentColor" stroke-width="10" stroke-linecap="round" fill="none"></path></svg></div>
                <div class="diverse-tile diverse-tile-peach-ink"><svg viewBox="0 0 100 100"><circle cx="50" cy="50" r="28" fill="none" stroke="currentColor" stroke-width="12"></circle></svg></div>
                <div class="diverse-tile diverse-tile-ink-brand"><svg viewBox="0 0 100 100"><path d="M10 72a40 40 0 0 1 80 0z" fill="currentColor"></path></svg></div>
            </div>
        </div>
    </section>

    <section class="diverse-stats" aria-label="{{#str}}landing_keyfigures, theme_diverse{{/str}}">
        <div class="diverse-stat">
            <span class="diverse-stat-value">{{partnercount}}</span>
            <span class="diverse-stat-label">{{#str}}stat_projectpartners, theme_diverse{{/str}}</span>
        </div>
        <div class="diverse-stat">
            <span class="diverse-stat-value">{{countrycount}}</span>
            <span class="diverse-stat-label">{{#str}}stat_countries, theme_diverse{{/str}}</span>
        </div>
        <div class="diverse-stat">
            <span class="diverse-stat-value">{{coursecount}}</span>
            <span class="diverse-stat-label">{{#str}}stat_courses, theme_diverse{{/str}}</span>
        </div>
    </section>

    <section class="diverse-section diverse-about" id="diverse-about" aria-labelledby="diverse-about-title">
        <div class="diverse-section-head">
            <p class="diverse-eyebrow">{{#str}}about_eyebrow, theme_diverse{{/str}}</p>
            <h2 class="diverse-section-title" id="diverse-about-title">{{#str}}about_title, theme_diverse{{/str}}</h2>
            <p class="diverse-lead">{{#str}}about_intro, theme_diverse{{/str}}</p>
            <p class="diverse-muted">{{#str}}about_support, theme_diverse{{/str}}</p>
        </div>
        <div class="diverse-cards diverse-cards-3">
            <div class="diverse-card">
                <div class="diverse-card-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 0 1-15.5 6.2M3 12a9 9 0 0 1 15.5-6.2"></path><path d="M18.5 2v4h-4M5.5 22v-4h4"></path></svg></div>
                <h3 class="diverse-card-title">{{#str}}focus_item1_title, theme_diverse{{/str}}</h3>
                <p class="diverse-muted">{{#str}}focus_item1_desc, theme_diverse{{/str}}</p>
            </div>
            <div class="diverse-card">
                <div class="diverse-card-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="12" rx="2"></rect><path d="M8 20h8M12 16v4"></path></svg></div>
                <h3 class="diverse-card-title">{{#str}}focus_item2_title, theme_diverse{{/str}}</h3>
                <p class="diverse-muted">{{#str}}focus_item2_desc, theme_diverse{{/str}}</p>
            </div>
            <div class="diverse-card">
                <div class="diverse-card-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L4 14h7l-1 8 9-12h-7z"></path></svg></div>
                <h3 class="diverse-card-title">{{#str}}focus_item3_title, theme_diverse{{/str}}</h3>
                <p class="diverse-muted">{{#str}}focus_item3_desc, theme_diverse{{/str}}</p>
            </div>
        </div>
    </section>

    <section class="diverse-section diverse-partners" id="diverse-partners" aria-labelledby="diverse-partners-title">
        <div class="diverse-section-head">
            <p class="diverse-eyebrow">{{#str}}partners_eyebrow, theme_diverse{{/str}}</p>
            <h2 class="diverse-section-title" id="diverse-partners-title">{{#str}}partners_title, theme_diverse{{/str}}</h2>
            <p class="diverse-lead">{{#str}}partners_intro, theme_diverse{{/str}}</p>
        </div>
        <ul class="diverse-cards diverse-cards-4 diverse-partner-list">
            {{#partners}}
            <li class="diverse-card diverse-card-outline diverse-partner">
                {{#lead}}<span class="diverse-partner-badge">{{#str}}partners_lead, theme_diverse{{/str}}</span>{{/lead}}
                <h3 class="diverse-partner-name">{{name}}</h3>
                <span class="diverse-muted">{{country}}</span>
                <div class="diverse-card-footer">
                    <a href="{{url}}" target="_blank" rel="noopener"><span class="visually-hidden">{{name}}: </span>{{domain}} <span aria-hidden="true">&nearr;</span></a>
                </div>
            </li>
            {{/partners}}
        </ul>
    </section>

    {{#hascourses}}
    <section class="diverse-section diverse-courses" id="diverse-courses" aria-labelledby="diverse-courses-title">
        <div class="diverse-section-head diverse-section-head-row">
            <h2 class="diverse-section-title" id="diverse-courses-title">{{#str}}courses_title, theme_diverse{{/str}}</h2>
            <a class="diverse-link-strong" href="{{allcoursesurl}}">{{#str}}courses_all, theme_diverse, {{coursecount}}{{/str}} <span aria-hidden="true">&rarr;</span></a>
        </div>
        <div class="diverse-cards diverse-cards-4">
            {{#courses}}
            <a class="diverse-course" href="{{url}}">
                <div class="diverse-course-cover diverse-course-cover-{{coverstyle}}">
                    {{#hasimage}}<img class="diverse-course-img" src="{{imageurl}}" alt="">{{/hasimage}}
                    {{^hasimage}}
                    <svg class="diverse-course-shape" viewBox="0 0 100 100" aria-hidden="true">
                        {{#isring}}<circle cx="50" cy="50" r="30" fill="none" stroke="currentColor" stroke-width="12"></circle>{{/isring}}
                        {{#isplus}}<path d="M50 20v60M20 50h60" stroke="currentColor" stroke-width="14" stroke-linecap="round" fill="none"></path>{{/isplus}}
                        {{#ishalf}}<path d="M10 72a40 40 0 0 1 80 0z" fill="currentColor"></path>{{/ishalf}}
                        {{#ishash}}<path d="M40 18L34 82M68 18L62 82M20 38h64M16 62h64" stroke="currentColor" stroke-width="10" stroke-linecap="round" fill="none"></path>{{/ishash}}
                    </svg>
                    {{/hasimage}}
                    <span class="diverse-chip">{{shortname}}</span>
                </div>
                <div class="diverse-course-body">
                    <span class="diverse-muted diverse-small">{{category}}</span>
                    <span class="diverse-course-title">{{fullname}}</span>
                </div>
            </a>
            {{/courses}}
        </div>
    </section>
    {{/hascourses}}
</div>
{{#js}}
document.querySelectorAll('.primary-navigation a[href*="#diverse-"]').forEach(function(anchor) {
    anchor.addEventListener('click', function(e) {
        var href = this.getAttribute('href');
        var hashIndex = href.indexOf('#');
        if (hashIndex !== -1) {
            var hash = href.substring(hashIndex + 1);
            var target = document.getElementById(hash);
            if (target) {
                e.preventDefault();
                target.scrollIntoView({ behavior: 'smooth' });
                if (history.pushState) {
                    history.pushState(null, null, '#' + hash);
                }
            }
        }
    });
});
{{/js}}
