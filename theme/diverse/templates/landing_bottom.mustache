{{!
    @template theme_diverse/landing_bottom

    Closing band of the landing page, shown below the site home content, and the partners' logos above the footer.

    The logos slide from right to left without end: the list is there twice, the copy hidden from screen readers, and
    the strip moves by the width of one list (scss/landing.scss). Without motion the copy is hidden and the logos wrap.

    Example context (json):
    {
        "homeurl": "#", "gt4turl": "#", "loggedin": false, "loginurl": "#", "dashboardurl": "#", "allcoursesurl": "#", "privacyurl": "#",
        "ctatext": "Courses from 8 partners in 5 countries, in one place.",
        "supporturl": "#", "copyright": "© 2026 DIVERSE European University Alliance",
        "haslogos": true, "logos": [{"name": "Griffith College", "url": "#", "logourl": "#"}]
    }
}}
<div class="diverse-landing">
    <section class="diverse-cta" aria-labelledby="diverse-cta-title">
        <div class="diverse-cta-inner">
            <div>
                <h2 class="diverse-cta-title" id="diverse-cta-title">{{#str}}cta_title, theme_diverse{{/str}}</h2>
                <p class="diverse-cta-text">{{ctatext}}</p>
            </div>
            <div class="diverse-hero-actions">
                <a class="btn btn-lg diverse-btn-ink" href="{{#loggedin}}{{dashboardurl}}{{/loggedin}}{{^loggedin}}{{loginurl}}{{/loggedin}}">
                    {{#loggedin}}{{#str}}myhome{{/str}}{{/loggedin}}{{^loggedin}}{{#str}}landing_getstarted, theme_diverse{{/str}}{{/loggedin}}
                </a>
                <a class="btn btn-lg diverse-btn-outline-ink" href="{{allcoursesurl}}">{{#str}}courses{{/str}}</a>
            </div>
        </div>
    </section>
    {{#haslogos}}
    <section class="diverse-logos" id="diverse-partners" aria-label="{{#str}}partners_eyebrow, theme_diverse{{/str}}">
        <div class="diverse-logos-track">
            <ul>
                {{#logos}}<li><a href="{{url}}" target="_blank" rel="noopener"><img src="{{logourl}}" alt="{{name}}"></a></li>{{/logos}}
            </ul>
            <ul aria-hidden="true">
                {{#logos}}<li><a href="{{url}}" target="_blank" rel="noopener" tabindex="-1"><img src="{{logourl}}" alt=""></a></li>{{/logos}}
            </ul>
        </div>
    </section>
    {{/haslogos}}
    <footer class="diverse-landing-footer-wrap">
        <div class="diverse-landing-footer">
            <div class="diverse-landing-footer-about">
                <div class="diverse-landing-footer-brands">
                    <a class="diverse-landing-footer-brand" href="{{homeurl}}">
                        {{#logourl}}<img src="{{logourl}}" class="diverse-landing-footer-logo" alt="DIVERSE">{{/logourl}}
                        {{^logourl}}<span class="diverse-landing-footer-heading">DIVERSE</span>{{/logourl}}
                    </a>
                    {{#gt4tlogourl}}
                    <a class="diverse-landing-footer-brand diverse-landing-footer-project" href="{{gt4turl}}" target="_blank" rel="noopener">
                        <img src="{{gt4tlogourl}}" class="diverse-landing-footer-project-logo" alt="GT4T – GreenTech4Transformation">
                    </a>
                    {{/gt4tlogourl}}
                </div>
                <p>{{#str}}footer_about, theme_diverse{{/str}}</p>
                <p class="diverse-landing-footer-small">{{#str}}about_support, theme_diverse{{/str}}</p>
            </div>
            <nav class="diverse-landing-footer-links" aria-label="{{#str}}footer_explore, theme_diverse{{/str}}">
                <span class="diverse-landing-footer-heading">{{#str}}footer_explore, theme_diverse{{/str}}</span>
                <a href="{{homeurl}}#diverse-about">{{#str}}nav_about, theme_diverse{{/str}}</a>
                <a href="{{homeurl}}#diverse-partners">{{#str}}nav_partners, theme_diverse{{/str}}</a>
                <a href="{{homeurl}}#diverse-courses">{{#str}}nav_courses, theme_diverse{{/str}}</a>
            </nav>
            <nav class="diverse-landing-footer-links" aria-label="{{#str}}footer_platform, theme_diverse{{/str}}">
                <span class="diverse-landing-footer-heading">{{#str}}footer_platform, theme_diverse{{/str}}</span>
                {{#loggedin}}<a href="{{dashboardurl}}">{{#str}}myhome{{/str}}</a>{{/loggedin}}
                {{^loggedin}}<a href="{{loginurl}}">{{#str}}login{{/str}}</a>{{/loggedin}}
                <a href="{{allcoursesurl}}">{{#str}}courses{{/str}}</a>
                <a href="{{privacyurl}}">{{#str}}footer_privacy, theme_diverse{{/str}}</a>
                <a href="{{supporturl}}">{{#str}}contactsitesupport, admin{{/str}}</a>
            </nav>
        </div>
        <div class="diverse-landing-footer-bottom">
            <span>{{copyright}}</span>
            <a href="{{gt4turl}}" target="_blank" rel="noopener">GT4T – GreenTech4Transformation <span aria-hidden="true">&nearr;</span></a>
        </div>
    </footer>
</div>
