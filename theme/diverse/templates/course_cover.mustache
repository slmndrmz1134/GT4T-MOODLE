{{!
    @template theme_diverse/course_cover

    Cover of a course: its image, or its initials on a brand colour when it has none.

    Example context (json):
    {
        "hasimage": false, "imageurl": "", "coverstyle": "brand", "initials": "BL"
    }
}}
<span class="diverse-course-cover diverse-course-cover-{{coverstyle}}" aria-hidden="true">
    {{#hasimage}}<img class="diverse-course-img" src="{{imageurl}}" alt="">{{/hasimage}}
    {{^hasimage}}<span class="diverse-course-initials">{{initials}}</span>{{/hasimage}}
</span>
