{{!
    @template theme_diverse/lesson_bar

    Bar above an activity: the course, the place in it and the way to the previous and next activity.

    Example context (json):
    {
        "courseurl": "#", "coursename": "Business Law", "position": "3 / 11", "hasprogress": true, "progress": 18,
        "hasprevious": true, "previousurl": "#", "hasnext": true, "nexturl": "#"
    }
}}
<nav class="diverse-lesson-bar" aria-label="{{coursename}}">
    <a class="diverse-lesson-course" href="{{courseurl}}">{{coursename}}</a>
    <span class="diverse-lesson-position">{{position}}</span>
    {{#hasprogress}}
    <span class="diverse-progress">
        <span class="diverse-progress-track"><span style="width: {{progress}}%;"></span></span>
        <span class="diverse-progress-value">{{#str}}dash_progress, theme_diverse, {{progress}}{{/str}}</span>
    </span>
    {{/hasprogress}}
    <span class="diverse-lesson-steps">
        {{#hasprevious}}<a class="btn btn-sm diverse-btn-on-dark" href="{{previousurl}}">{{#str}}lesson_previous, theme_diverse{{/str}}</a>{{/hasprevious}}
        {{#hasnext}}<a class="btn btn-sm btn-primary" href="{{nexturl}}">{{#str}}lesson_next, theme_diverse{{/str}}</a>{{/hasnext}}
    </span>
</nav>
