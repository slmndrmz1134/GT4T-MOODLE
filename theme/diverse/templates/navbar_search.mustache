<div class="diverse-navbar-search d-none d-xl-flex align-items-center">
    <form action="{{{ action }}}" method="get" class="diverse-search-form" role="search">
        <div class="diverse-search-box">
            <span class="diverse-search-icon" aria-hidden="true">
                <i class="fa fa-magnifying-glass" aria-hidden="true"></i>
            </span>
            <input type="search"
                   name="{{{ inputname }}}"
                   class="form-control diverse-search-input"
                   placeholder="{{{ searchstring }}}"
                   aria-label="{{{ searchstring }}}"
                   autocomplete="off" />
        </div>
    </form>
</div>
