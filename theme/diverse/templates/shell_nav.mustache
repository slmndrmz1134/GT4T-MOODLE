{{!
    @template theme_diverse/shell_nav

    Application navigation for logged-in users: a row of links under the top bar, a tab bar at the bottom on phones.

    Context variables required for this template:
    * main - the main places, the platform guide last: label, url, icon (icon class), current, nophone
    * manage, hasmanage - management places of partner managers and site administrators
    * managecurrent - whether one of the management places is open

    Example context (json):
    {
        "main": [{"label": "Dashboard", "url": "#", "icon": "fa-book", "current": true}],
        "manage": [], "hasmanage": false, "managecurrent": false
    }
}}
<nav class="diverse-nav" aria-label="{{#str}}shell_nav, theme_diverse{{/str}}">
    <ul class="diverse-nav-list">
        {{#main}}
        <li{{#nophone}} class="diverse-nav-nophone"{{/nophone}}><a class="diverse-nav-link{{#current}} active{{/current}}" href="{{url}}"{{#current}} aria-current="page"{{/current}}>
            <i class="fa {{icon}}" aria-hidden="true"></i>
            <span>{{label}}</span>
        </a></li>
        {{/main}}
    </ul>
    {{#hasmanage}}
    <div class="dropdown diverse-nav-manage">
        <button type="button" class="diverse-nav-link dropdown-toggle{{#managecurrent}} active{{/managecurrent}}" data-bs-toggle="dropdown" aria-expanded="false">
            <span>{{#str}}administration{{/str}}</span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
            {{#manage}}
            <li><a class="dropdown-item{{#current}} active{{/current}}" href="{{url}}"{{#current}} aria-current="page"{{/current}}>{{label}}</a></li>
            {{/manage}}
        </ul>
    </div>
    {{/hasmanage}}
</nav>
