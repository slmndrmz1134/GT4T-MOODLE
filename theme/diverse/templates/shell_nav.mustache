{{!
    @template theme_diverse/shell_nav

    Application navigation for logged-in users: a rail of icons on the left, a tab bar at the bottom on phones.
    On the rail the names show next to the icons on hover and focus.

    Context variables required for this template:
    * homeurl, brand, brandletter - the mark at the top of the rail (the first letter of the user's university),
      leading to the site home
    * main - the main places, the platform guide last: key, label, url, icon (icon class), current, nophone
    * bottom - help and preferences at the bottom of the rail; the user menu shows under them (shell.scss)
    * manage, hasmanage, manageicon - management places of partner managers and site administrators
    * managecurrent - whether one of the management places is open

    Example context (json):
    {
        "homeurl": "#", "brand": "DIVERSE", "brandletter": "D",
        "main": [{"key": "dashboard", "label": "Dashboard", "url": "#", "icon": "fa-book", "current": true}],
        "bottom": [], "manage": [], "hasmanage": false, "manageicon": "fa-gear", "managecurrent": false
    }
}}
<nav class="diverse-nav" aria-label="{{#str}}shell_nav, theme_diverse{{/str}}">
    <a class="diverse-nav-brand" href="{{homeurl}}" title="{{brand}}"><span aria-hidden="true">{{brandletter}}</span><span class="visually-hidden">{{brand}}</span></a>
    <ul class="diverse-nav-list">
        {{#main}}
        <li class="diverse-nav-item-{{key}}{{#nophone}} diverse-nav-nophone{{/nophone}}"><a class="diverse-nav-link{{#current}} active{{/current}}" href="{{url}}"{{#current}} aria-current="page"{{/current}}>
            <i class="fa {{icon}}" aria-hidden="true"></i>
            <span>{{label}}</span>
        </a></li>
        {{/main}}
    </ul>
    {{#hasmanage}}
    <div class="dropdown dropend diverse-nav-manage">
        <button type="button" class="diverse-nav-link dropdown-toggle{{#managecurrent}} active{{/managecurrent}}" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="fa {{manageicon}}" aria-hidden="true"></i>
            <span>{{#str}}administration{{/str}}</span>
        </button>
        <ul class="dropdown-menu">
            {{#manage}}
            <li><a class="dropdown-item{{#current}} active{{/current}}" href="{{url}}"{{#current}} aria-current="page"{{/current}}>{{label}}</a></li>
            {{/manage}}
        </ul>
    </div>
    {{/hasmanage}}
    <ul class="diverse-nav-list diverse-nav-bottom">
        {{#bottom}}
        <li class="diverse-nav-item-{{key}}"><a class="diverse-nav-link{{#current}} active{{/current}}" href="{{url}}"{{#current}} aria-current="page"{{/current}}>
            <i class="fa {{icon}}" aria-hidden="true"></i>
            <span>{{label}}</span>
        </a></li>
        {{/bottom}}
    </ul>
</nav>
