{{!
    @template theme_diverse/shell_nav

    Application navigation for logged-in users: a rail on the left, a tab bar at the bottom on phones.

    Context variables required for this template:
    * main - the main places: label, url, icon (SVG path), current
    * manage, hasmanage - management places of partner managers and site administrators
    * home - the public site home

    Example context (json):
    {
        "main": [{"label": "Dashboard", "url": "#", "icon": "M3 3h7v7H3z", "current": true}],
        "manage": [], "hasmanage": false,
        "home": {"label": "Home", "url": "#", "icon": "M3 11l9-8 9 8", "current": false}
    }
}}
<nav class="diverse-rail" aria-label="{{#str}}shell_nav, theme_diverse{{/str}}">
    <ul class="diverse-rail-list">
        {{#main}}
        <li{{#nophone}} class="diverse-rail-nophone"{{/nophone}}><a class="diverse-rail-link{{#current}} active{{/current}}" href="{{url}}"{{#current}} aria-current="page"{{/current}}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="{{icon}}"></path></svg>
            <span>{{label}}</span>
        </a></li>
        {{/main}}
    </ul>
    {{#hasmanage}}
    <ul class="diverse-rail-list diverse-rail-manage">
        {{#manage}}
        <li><a class="diverse-rail-link{{#current}} active{{/current}}" href="{{url}}"{{#current}} aria-current="page"{{/current}}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="{{icon}}"></path></svg>
            <span>{{label}}</span>
        </a></li>
        {{/manage}}
    </ul>
    {{/hasmanage}}
    <ul class="diverse-rail-list diverse-rail-end">
        {{#home}}
        <li><a class="diverse-rail-link" href="{{url}}">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="{{icon}}"></path></svg>
            <span>{{label}}</span>
        </a></li>
        {{/home}}
    </ul>
</nav>
