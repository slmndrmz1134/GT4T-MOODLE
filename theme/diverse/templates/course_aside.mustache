{{!
    @template theme_diverse/course_aside

    The column next to the sections on the course page: the next live class, the deadlines of the course, the
    course assistant and the teachers. The assistant card only stays when local_diverse_assistant has put its own
    button on the page, which the card then presses.

    It also carries the progress of the student in each section (sectionsjson), which its script shows in the
    headers of the sections on the page.

    Example context (json):
    {
        "sectionsjson": "{\"sections\": [], \"next\": 0}",
        "haslive": true, "live": {"name": "Live class", "when": "Thursday, 5 November 2026, 2:00 PM", "url": "#", "scheduled": true},
        "hasdeadlines": false, "deadlines": [], "calendarurl": "#", "assistant": false,
        "hasteachers": true, "teachers": [{"name": "Ada Yilmaz", "role": "Teacher", "initials": "AY", "messageurl": "#"}]
    }
}}
<aside class="diverse-course-aside" aria-label="{{#str}}course_aside, theme_diverse{{/str}}">
    {{#haslive}}{{#live}}
    <section class="diverse-card diverse-live">
        <small>{{#scheduled}}{{#str}}course_live_next, theme_diverse{{/str}}{{/scheduled}}{{^scheduled}}{{#str}}course_live_room, theme_diverse{{/str}}{{/scheduled}}</small>
        <strong>{{name}}</strong>
        <p>{{#scheduled}}{{when}}{{/scheduled}}{{^scheduled}}{{#str}}course_live_none, theme_diverse{{/str}}{{/scheduled}}</p>
        <a class="btn" href="{{url}}"><i class="fa fa-tower-broadcast" aria-hidden="true"></i> {{#str}}course_live_join, theme_diverse{{/str}}</a>
    </section>
    {{/live}}{{/haslive}}

    <section class="diverse-card">
        <div class="diverse-card-head">
            <h2>{{#str}}dash_deadlines, theme_diverse{{/str}}</h2>
            <a class="diverse-card-more" href="{{calendarurl}}">{{#str}}calendar, core_calendar{{/str}}</a>
        </div>
        {{#hasdeadlines}}
        <ul class="diverse-mini-list">
            {{#deadlines}}
            <li>
                <span class="diverse-date{{#overdue}} overdue{{/overdue}}" aria-hidden="true"><b>{{day}}</b><small>{{month}}</small></span>
                <span><a href="{{url}}">{{name}}</a><span>{{meta}}</span></span>
            </li>
            {{/deadlines}}
        </ul>
        {{/hasdeadlines}}
        {{^hasdeadlines}}<p class="diverse-empty">{{#str}}course_nodeadlines, theme_diverse{{/str}}</p>{{/hasdeadlines}}
    </section>

    {{#assistant}}
    <section class="diverse-card diverse-course-assistant" hidden>
        <div class="diverse-card-head"><i class="fa fa-wand-magic-sparkles" aria-hidden="true"></i><h2>{{#str}}course_assistant, theme_diverse{{/str}}</h2></div>
        <p>{{#str}}course_assistant_text, theme_diverse{{/str}}</p>
        <button type="button" class="btn btn-secondary" data-action="diverse-open-assistant">{{#str}}course_assistant_open, theme_diverse{{/str}}</button>
    </section>
    {{/assistant}}

    {{#hasteachers}}
    <section class="diverse-card">
        <div class="diverse-card-head"><h2>{{#str}}course_teachers, theme_diverse{{/str}}</h2></div>
        <ul class="diverse-mini-list">
            {{#teachers}}
            <li>
                <span class="diverse-initials" aria-hidden="true">{{initials}}</span>
                <span><strong>{{name}}</strong><span>{{role}}</span></span>
                {{#messageurl}}<a class="diverse-icon-link" href="{{messageurl}}" title="{{#str}}course_message, theme_diverse, {{name}}{{/str}}"><i class="fa fa-message" aria-hidden="true"></i><span class="visually-hidden">{{#str}}course_message, theme_diverse, {{name}}{{/str}}</span></a>{{/messageurl}}
            </li>
            {{/teachers}}
        </ul>
    </section>
    {{/hasteachers}}
</aside>
{{#js}}
// The sections on the page: how far the student is in each (under the name, and a bar next to the arrow), a tick for
// the finished ones and a mark on the section and the activity to do next.
(function() {
    var data = {{{sectionsjson}}};
    data.sections.forEach(function(section) {
        var item = document.querySelector('li.course-section[data-number="' + section.number + '"]');
        var name = item && item.querySelector('.course-section-header .sectionname');
        if (!name || name.querySelector('.diverse-section-done')) {
            return;
        }
        var text = document.createElement('small');
        text.className = 'diverse-section-done';
        text.textContent = section.text;
        name.appendChild(text);
        var meter = document.createElement('span');
        meter.className = 'diverse-progress diverse-section-meter';
        meter.setAttribute('aria-hidden', 'true');
        meter.innerHTML = '<span class="diverse-progress-track"><span></span></span><span class="diverse-progress-value"></span>';
        meter.querySelector('.diverse-progress-track > span').style.width = section.percent + '%';
        meter.querySelector('.diverse-progress-value').textContent = section.percent + '%';
        name.parentNode.appendChild(meter);
        item.classList.toggle('diverse-section-finished', section.percent >= 100);
    });
    var next = data.next && document.getElementById('module-' + data.next);
    if (next) {
        next.classList.add('diverse-activity-next');
        var section = next.closest('li.course-section');
        if (section) {
            section.classList.add('diverse-section-current');
        }
    }
})();
{{/js}}
{{#assistant}}
{{#js}}
(function() {
    var card = document.querySelector('.diverse-course-assistant');
    var toggle = document.querySelector('[data-action="local-diverse-assistant-toggle"]');
    if (!card || !toggle) {
        return;
    }
    card.hidden = false;
    card.querySelector('[data-action="diverse-open-assistant"]').addEventListener('click', function() {
        toggle.click();
    });
})();
{{/js}}
{{/assistant}}
