{{!
    @template theme_diverse/dashboard_deadlines

    The user's next deadlines on the dashboard: overdue ones first, each with a button that opens the work.

    Example context (json):
    {
        "deadlines": [{"name": "Essay", "meta": "Due in 3 days · Business Law · Fri 6 Nov", "overdue": false,
            "url": "#", "action": "Add submission"}],
        "hasdeadlines": true
    }
}}
{{#hasdeadlines}}
<ul class="diverse-deadlines">
    {{#deadlines}}
    <li class="diverse-deadline{{#overdue}} overdue{{/overdue}}">
        <span class="diverse-deadline-state" aria-hidden="true"><i class="fa {{#overdue}}fa-circle-exclamation{{/overdue}}{{^overdue}}fa-clock{{/overdue}}"></i></span>
        <span class="diverse-deadline-text"><a href="{{url}}">{{name}}</a><span>{{meta}}</span></span>
        <a class="btn btn-sm {{#overdue}}btn-primary{{/overdue}}{{^overdue}}btn-secondary{{/overdue}}" href="{{url}}" title="{{action}}">{{#overdue}}{{#str}}dash_submit, theme_diverse{{/str}}{{/overdue}}{{^overdue}}{{#str}}dash_open, theme_diverse{{/str}}{{/overdue}}<span class="visually-hidden">: {{name}}</span></a>
    </li>
    {{/deadlines}}
</ul>
{{/hasdeadlines}}
{{^hasdeadlines}}<p class="diverse-empty">{{#str}}dash_todo_empty, theme_diverse{{/str}}</p>{{/hasdeadlines}}
