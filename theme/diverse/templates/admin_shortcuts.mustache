{{!
    @template theme_diverse/admin_shortcuts

    Above Moodle's site administration: the pages a DIVERSE administrator opens most, one tile each. Moodle's full
    menu follows below, unchanged.

    Example context (json):
    {
        "items": [{"label": "Browse list of users", "url": "#", "icon": "fa-users"},
                  {"label": "Partners", "url": "#", "icon": "fa-building"}]
    }
}}
<section class="diverse-admin-shortcuts" aria-labelledby="diverse-admin-shortcuts">
    <h2 id="diverse-admin-shortcuts">{{#str}}admin_shortcuts, theme_diverse{{/str}}</h2>
    <ul>
        {{#items}}
        <li><a href="{{url}}"><span class="diverse-stat-icon" aria-hidden="true"><i class="fa {{icon}}"></i></span><span>{{label}}</span></a></li>
        {{/items}}
    </ul>
</section>
