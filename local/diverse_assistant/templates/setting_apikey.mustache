{{!
    @template local_diverse_assistant/setting_apikey

    API key field of the plugin settings. The saved key is never put in the page.

    Example context (json):
    {
        "id": "id_s_local_diverse_assistant_apikey",
        "name": "s_local_diverse_assistant_apikey",
        "set": true,
        "placeholder": "sk-..."
    }
}}
<div class="form-text-setting">
    <input type="password" class="form-control text-ltr" id="{{id}}" name="{{name}}[key]" size="60"
           autocomplete="new-password" spellcheck="false"
           placeholder="{{#set}}{{#str}} apikey_placeholder_set, local_diverse_assistant {{/str}}{{/set}}{{^set}}{{placeholder}}{{/set}}">
    {{#set}}
        <div class="form-text text-success mt-1">{{#str}} apikey_saved, local_diverse_assistant {{/str}}</div>
        <div class="form-check mt-1">
            <input class="form-check-input" type="checkbox" id="{{id}}_remove" name="{{name}}[remove]" value="1">
            <label class="form-check-label" for="{{id}}_remove">{{#str}} apikey_remove, local_diverse_assistant {{/str}}</label>
        </div>
    {{/set}}
</div>
