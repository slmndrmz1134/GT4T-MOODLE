{{!
    @template local_diverse_videonotes/panel

    The user's bookmarks on the video of an activity: a moment and a short note each; a click on one plays the video
    from there. Hidden until the script finds a video it can control, then moved under it.

    Example context (json):
    {
        "maxlength": 255
    }
}}
<section class="local-diverse-videonotes" aria-labelledby="local-diverse-videonotes-title" hidden>
    <div class="local-diverse-videonotes-head">
        <h2 id="local-diverse-videonotes-title"><i class="fa fa-bookmark-o" aria-hidden="true"></i> {{#str}}title, local_diverse_videonotes{{/str}}</h2>
        <span class="local-diverse-videonotes-hint">{{#str}}hint, local_diverse_videonotes{{/str}}</span>
    </div>
    <form class="local-diverse-videonotes-form" data-region="form">
        <label class="visually-hidden" for="local-diverse-videonotes-note">{{#str}}note, local_diverse_videonotes{{/str}}</label>
        <input type="text" id="local-diverse-videonotes-note" class="form-control" data-region="note" maxlength="{{maxlength}}"
            placeholder="{{#str}}note_placeholder, local_diverse_videonotes{{/str}}">
        <button type="submit" class="btn btn-primary">
            <i class="fa fa-bookmark" aria-hidden="true"></i> {{#str}}add, local_diverse_videonotes{{/str}} <span data-region="now">0:00</span>
        </button>
    </form>
    <ol class="local-diverse-videonotes-list" data-region="list"></ol>
    <p class="local-diverse-videonotes-empty" data-region="empty">{{#str}}empty, local_diverse_videonotes{{/str}}</p>
    <template data-region="item">
        <li>
            <button type="button" class="local-diverse-videonotes-jump" data-action="jump">
                <span class="local-diverse-videonotes-time" data-region="time"></span>
                <span class="local-diverse-videonotes-text" data-region="text"></span>
            </button>
            <button type="button" class="local-diverse-videonotes-delete" data-action="delete" title="{{#str}}delete, local_diverse_videonotes{{/str}}">
                <i class="fa fa-trash-o" aria-hidden="true"></i><span class="visually-hidden">{{#str}}delete, local_diverse_videonotes{{/str}}</span>
            </button>
        </li>
    </template>
</section>
