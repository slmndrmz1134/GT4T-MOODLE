# Local settings for docker compose. Copy to .env (git ignores .env) and fill in; never commit real values.
#
# Outgoing mail (Gmail SMTP). Leave SMTP_USER empty to send no mail. See docs/MAIL_SETUP.md.
# SMTP_HOST   default smtp.gmail.com:587 (host:port)
# SMTP_SECURE default tls (ssl for port 465)
# SMTP_USER   the Gmail address
# SMTP_PASS   a Gmail app password (16 characters, no spaces), not the account password
# SMTP_FROM   sender address; default SMTP_USER (Gmail only sends from the account or its verified aliases)
SMTP_HOST=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
