# Moodle data directory (managed by Docker volume)
moodledata/

# Root config.php is generated per environment (Docker entrypoint / cPanel) - do not track.
# Anchored with "/" so plugin and theme config.php files (e.g. theme/moove/config.php) stay tracked.
/config.php

# Node modules (if Moodle npm install is run locally)
node_modules/

# OS files
Thumbs.db
.DS_Store

# Local environment files and secrets
.env
.env.save*
nginx/.htpasswd
